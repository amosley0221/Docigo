# Copy this file to .env and fill in your Supabase project values.
# Both are publishable values; safe to ship in browser code.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: URL of the docigo-convert service used to render PowerPoint
# (and other unsupported formats) into a previewable PDF on upload.
# Leave unset to disable; uploads proceed normally and PowerPoints show
# the "export as PDF" hint card.
VITE_CONVERT_URL=https://docigo-convert.onrender.com
